# ASCENT: writes OUT (ascent_version.h) with the version of the source:
# VERSION (the setup version, can be empty) and "git describe". The file
# is written only when the text changes, so that a build without a change
# does not compile again. The build runs it with cmake -P each time.
set(DESCRIBE "")
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} describe --tags --always --dirty
    WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE DESCRIBE
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif()
if(DESCRIBE STREQUAL "")
  set(DESCRIBE "unknown")
endif()
if(VERSION STREQUAL "")
  set(TEXT "${DESCRIBE}")
else()
  set(TEXT "${VERSION} (${DESCRIBE})")
endif()
set(CONTENT "// Generated by cmake/version.cmake. Do not edit.\n#define ASCENT_VERSION_STRING \"${TEXT}\"\n#define ASCENT_BUILD_TYPE \"${BUILD_TYPE}\"\n")
if(EXISTS ${OUT})
  file(READ ${OUT} OLD)
else()
  set(OLD "")
endif()
if(NOT OLD STREQUAL CONTENT)
  file(WRITE ${OUT} "${CONTENT}")
endif()
