# ASCENT: writes OUT, a C file with the bytes of the file IN as the array
# NAME (a string that ends with a 0 byte). Used for the translations of
# the text of the code (engine/lang/*_port.catalog, docs/formats/lang.md).
# Run with cmake -DIN=... -DOUT=... -DNAME=... -P embed_text.cmake
file(READ "${IN}" HEX HEX)
string(LENGTH "${HEX}" LEN)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
# 32 bytes on each line
string(REGEX REPLACE "((0x..,){32})" "\\1\n" BYTES "${BYTES}")
file(WRITE "${OUT}" "// Generated by cmake/embed_text.cmake from ${IN}. Do not edit.\nconst unsigned char ${NAME}[] = {\n${BYTES}0 };\n")
