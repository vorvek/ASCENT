{
  "version": 2,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug build for development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release build for the installer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-rel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ASCENT_RELEASE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "targets": [ "ascent", "ascent-import", "ascent-content" ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
